#!/bin/sh /etc/rc.common
# OpenWrt procd-сервис для nowplaying-server.
# Установка: скопировать в /etc/init.d/nowplaying, chmod +x, /etc/init.d/nowplaying enable
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/nowplaying-server -config /etc/nowplaying/config.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param oom_score_adj 200
    procd_close_instance
}
